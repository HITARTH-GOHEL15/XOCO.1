<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movie_background"
    android:transitionGroup="true">
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auth Options"
        android:ellipsize="start"
        android:textSize="40sp"
        android:textColor="@color/movie_primary"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:fontFamily="@font/bebasneue_regular"
        app:fontFamily="@font/bebasneue_regular"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="select a way you wanted to do authentication."
        android:ellipsize="start"
        android:textSize="15sp"
        android:textColor="@color/movie_text_secondary"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingBottom="5dp"
        android:fontFamily="@font/poppins_medium"
        app:fontFamily="@font/poppins_medium"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emailAuthButton"
        style="@style/Widget.MovieExplorer.Button"
        android:backgroundTint="@color/movie_primary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="2dp"
        android:text="sign in with Email"
        app:icon="@drawable/mail_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
        app:iconGravity="textStart"
        app:cornerRadius="28dp"
        app:iconPadding="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/phoneAuthButton"
        style="@style/Widget.MovieExplorer.Button"
        android:backgroundTint="@color/movie_primary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="sign in with Phone"
        app:icon="@drawable/phone_in_talk_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
        app:iconGravity="textStart"
        app:cornerRadius="28dp"
        app:iconPadding="8dp"/>

</LinearLayout>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/authTypesTopBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationContentDescription="navigation_back"
        app:navigationIcon="@drawable/ic_back_circle"/>

</FrameLayout>