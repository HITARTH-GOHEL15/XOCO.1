<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welocme_back"
        android:ellipsize="start"
        android:textSize="40sp"
        android:textColor="@color/movie_primary"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:fontFamily="@font/bebasneue_regular"
        app:fontFamily="@font/bebasneue_regular"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_subtitle"
        android:ellipsize="start"
        android:textSize="15sp"
        android:textColor="@color/movie_text_secondary"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingBottom="5dp"
        android:fontFamily="@font/poppins_medium"
        app:fontFamily="@font/poppins_medium"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email"
        android:ellipsize="start"
        android:textSize="20sp"
        android:textColor="@color/movie_text_primary"
        android:textFontWeight="@integer/material_motion_duration_long_1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:fontFamily="@font/poppins_medium"
        app:fontFamily="@font/poppins_medium"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/email_textField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="emailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:textColorHint="@color/movie_text_primary"
        app:helperText="yourName@gmail.com"
        app:helperTextEnabled="true"
        app:counterEnabled="true"
        app:counterMaxLength="30"
        app:errorEnabled="true"
        style="@style/Widget.MovieExplorer.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Password"
        android:ellipsize="start"
        android:textSize="20sp"
        android:textColor="@color/movie_text_primary"
        android:textFontWeight="@integer/material_motion_duration_long_1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:paddingTop="16dp"
        android:fontFamily="@font/poppins_medium"
        app:fontFamily="@font/poppins_medium"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password_textField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="emailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:textColorHint="@color/movie_text_primary"
        app:endIconMode="password_toggle"
        app:helperText="user@12345"
        app:helperTextEnabled="true"
        app:counterEnabled="true"
        app:counterMaxLength="30"
        app:errorEnabled="true"
        style="@style/Widget.MovieExplorer.TextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginButton"
        style="@style/Widget.MovieExplorer.Button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="Log in"
        app:cornerRadius="28dp"
        app:iconPadding="8dp"
        app:iconTint="@color/movie_on_primary"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account?"
            android:ellipsize="start"
            android:textSize="15sp"
            android:textColor="@color/movie_text_secondary"
            android:paddingStart="15dp"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp"
            android:fontFamily="@font/poppins_medium"
            app:fontFamily="@font/poppins_medium"/>

        <TextView
            android:id="@+id/register_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register here"
            android:ellipsize="start"
            android:textSize="15sp"
            android:textColor="@color/movie_accent_text"
            android:paddingEnd="15dp"
            android:paddingBottom="5dp"
            android:fontFamily="@font/poppins_medium"
            app:fontFamily="@font/poppins_medium"
            android:clickable="true"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="8dp"
        android:gravity="center">

        <View
            android:layout_width="160dp"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp"
            android:background="@color/movie_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OR"
            android:ellipsize="start"
            android:textSize="15sp"
            android:textColor="@color/movie_text_secondary"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_medium"
            app:fontFamily="@font/poppins_medium"/>

        <View
            android:layout_width="160dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp"
            android:background="@color/movie_text_secondary"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/googleSignIn"
        style="@style/Widget.MovieExplorer.Button"
        android:backgroundTint="@color/movie_text_secondary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/sign_in_with_google"
        app:icon="@drawable/icons8_google_48"
        app:iconGravity="textStart"
        app:cornerRadius="28dp"
        app:iconPadding="8dp"/>



</LinearLayout>