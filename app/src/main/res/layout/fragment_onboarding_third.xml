<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:id="@+id/animation_view"
        app:lottie_rawRes="@raw/animation2"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_third_title"
        android:ellipsize="start"
        android:textSize="30sp"
        android:textColor="@color/movie_primary"
        android:gravity="center"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="15dp"
        android:paddingBottom="5dp"
        android:fontFamily="@font/bebasneue_regular"
        app:fontFamily="@font/bebasneue_regular"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_third_subtitle"
        android:ellipsize="start"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="@color/movie_text_secondary"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingBottom="5dp"
        android:fontFamily="@font/poppins_medium"
        app:fontFamily="@font/poppins_medium"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/GetStartedButton"
        style="@style/Widget.MovieExplorer.Button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="Get Started"
        app:cornerRadius="28dp"
        app:iconPadding="8dp"
        app:iconTint="@color/movie_on_primary"/>

</LinearLayout>